{
	"name": "sveltekit-supabase-shadcn",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:reset": "node -e \"require('node:fs').rmSync('.local', { recursive: true, force: true })\"",
		"gen:types": "supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" --schema public > src/lib/types/database.types.ts"
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.4",
		"@sveltejs/adapter-auto": "^9.0.0",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.7",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.8"
	},
	"dependencies": {
		"@lucide/svelte": "^1.79.0",
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.119.2",
		"bits-ui": "^2.22.0",
		"clsx": "^2.1.1",
		"cn": "^0.5.2",
		"mode-watcher": "^1.1.0",
		"svelte-sonner": "^1.2.3",
		"tailwind-merge": "^3.7.1",
		"tailwind-variants": "^3.3.1",
		"zod": "^4.6.7"
	}
}
