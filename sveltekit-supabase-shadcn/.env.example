# Both Supabase variables are optional. If you leave them empty the app runs
# against a local SQLite database (.local/dev.db) so you can develop and test
# the full app without a Supabase project. See the README for the demo login.

# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
PUBLIC_SUPABASE_URL=""

# Supabase publishable (anon) key — safe to expose to the browser.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Only used by the `npm run gen:types` script (your project ref).
SUPABASE_PROJECT_ID=""
